

#Область ПрограммныйИнтерфейс

// Параметры JSON.
// 
// Возвращаемое значение:
//  ПараметрыЗаписиJSON - Параметры JSON
Функция ПараметрыJSON() Экспорт
	Возврат Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.ПС);
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция НоваяЗаписьJSON(ЗаписываемыеДанные) Экспорт
	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку(ПараметрыJSON());
	ЗаписатьJSON(Запись, ЗаписываемыеДанные);
	Возврат Запись;	
КонецФункции

// Безопасное получение значения из структуры/таблицы по пути
// Пример: ПолучитьЗначение(Данные, "ОрганизацияРеквизиты.ИНН")
Функция ПолучитьЗначение(Данные, Путь, ЗначениеПоУмолчанию = Неопределено) Экспорт
    
    Части = СтрРазделить(Путь, ".");
    ТекущееЗначение = Данные;
    
    Для каждого Часть Из Части Цикл
        Если ТипЗнч(ТекущееЗначение) = Тип("Структура") Тогда
            Если ТекущееЗначение.Свойство(Часть) Тогда
                ТекущееЗначение = ТекущееЗначение[Часть];
            Иначе
                Возврат ЗначениеПоУмолчанию;
            КонецЕсли;
        Иначе
            Возврат ЗначениеПоУмолчанию;
        КонецЕсли;
    КонецЦикла;
    
    Возврат ТекущееЗначение;
    
КонецФункции

Процедура ЛогВ(Сообщение, Уровень = "И") Экспорт
    
    ТекущееВремя = ТекущаяДатаСеанса();
    ПрефиксУровня = "[ИНФОРМАЦИЯ]";
    УровеньЖурнала = УровеньЖурналаРегистрации.Информация;
    
    Если Уровень = "Э" Тогда  // Ошибка
        ПрефиксУровня = "[ОШИБКА]";
        УровеньЖурнала = УровеньЖурналаРегистрации.Ошибка;
    ИначеЕсли Уровень = "В" Тогда  // Внимание
        ПрефиксУровня = "[ВНИМАНИЕ]";
        УровеньЖурнала = УровеньЖурналаРегистрации.Предупреждение;
    КонецЕсли;
    
    ПолноеСообщение = СтрШаблон("%1 [%2] %3", ПрефиксУровня, Формат(ТекущееВремя, "ДФ=HH:mm:ss"), Сообщение);
    
    ЗаписьЖурналаРегистрации("МойПрограммныйКод", УровеньЖурнала,,, ПолноеСообщение);
    
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОчиститьСтрокуРегулярка(Текст)

	// Шаблон [^0-9] ищет все символы, кроме цифр
	Шаблон ="[^0-9]";		
	// Заменяем все найденные совпадения на пустую строку
	ОчищенныйТекст = СтрЗаменить(Текст, Шаблон, "");
	//Еще что-то дописываю	
	Возврат ОчищенныйТекст;

КонецФункции

#КонецОбласти
